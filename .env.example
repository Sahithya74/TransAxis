# TransAxis environment template. Copy to .env and fill in. Never commit .env.

NODE_ENV=development

# --- MySQL (local MySQL 8.0 service "MySQL80") ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Admin credentials are used ONLY by `npm run db:bootstrap` to create the databases and app user.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
# Written by db:bootstrap (least-privilege app user):
DATABASE_URL=
DATABASE_URL_TEST=

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
# Further origins the web app is served from, comma-separated (e.g. a LAN address). `npm run share` sets this itself.
EXTRA_WEB_ORIGINS=
# Express "trust proxy": true/false, a hop count, or a name such as loopback. Unset: 1 in production, off otherwise.
TRUST_PROXY=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Encrypts two-step (authenticator) secrets at rest. Generate like JWT_ACCESS_SECRET. Unset: derived from
# JWT_ACCESS_SECRET, so rotating that secret then means everyone re-enrols two-step sign-in.
TOTP_ENCRYPTION_KEY=
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=20

# --- Tracking ---
TELEMATICS_PROVIDER=simulated

# --- Messaging (optional; log-only when unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- RAG service (document search and the AI assistant; set up with npm run rag:setup) ---
RAG_PORT=8001
RAG_SERVICE_URL=http://127.0.0.1:8001
# Shared secret (at least 32 characters) used to sign the API's short-lived tokens to the RAG service.
RAG_SERVICE_SECRET=
# hashing (default, deterministic, no download) or fastembed (local semantic model; npm run rag:setup -- --semantic)
EMBEDDING_PROVIDER=hashing
# auto: Claude when ANTHROPIC_API_KEY is set, otherwise a labelled mock mode. claude or mock force one.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
QDRANT_PATH=./storage/qdrant
QDRANT_URL=
MAX_DOCUMENT_MB=15

# --- UI/UX design service (optional; not yet consumed by any code) ---
UIUX_API_KEY=

# --- Seed ---
SEED_ANCHOR_DATE=
